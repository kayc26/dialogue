{
  "include": [
    "vite.config.ts",
    "vitest.db.config.ts",
    "db/**/*.ts",
    "kb/**/*.ts",
    "functions/**/*.ts",
    "src/lib/proxy/handler.ts",
    "src/lib/proxy/jwt.ts",
    "src/lib/proxy/policy.ts",
    "src/lib/proxy/cost.ts",
    "src/lib/kb/chunk.ts",
    "src/lib/kb/tags.ts",
    "patients/**/*.ts",
    "src/lib/neon/auth.ts",
    "src/lib/neon/data.ts",
    "src/lib/chat/**/*.ts",
    "src/lib/patients/readback.ts",
    "src/lib/agent.ts",
    "src/lib/types.ts",
    "src/lib/openrouter.ts",
    "src/lib/accumulate.ts",
    "src/lib/sse.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  }
}
