{
  "include": [
    "vite.config.ts",
    "vitest.db.config.ts",
    "db/**/*.ts",
    "kb/**/*.ts",
    "src/lib/kb/chunk.ts",
    "src/lib/kb/tags.ts",
    "patients/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  }
}
