# macOS metadata
.DS_Store

# Temporary files
~*

# Python temporary files
__pycache__/
*.py[cod]

# Node / Vite
node_modules/
dist/
*.tsbuildinfo
coverage/

# Secrets — never commit an API key or connection string (ADR-0001, ADR-0014);
# anything in a .env file would be inlined into the public bundle.
.env
.env.*
*.local
# ADR Manager extension working state (drafts, backups) — editor-local, not records
docs/adr/.working/
.neon

# Knowledge base: ADA material is copyrighted and must never be committed (ADR-0005).
# Only the code and the manifest are tracked; extracted text and passages stay local.
kb/out/
kb/local-sources/
